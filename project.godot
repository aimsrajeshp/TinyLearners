; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited
; by the editor.

config_version=5

[application]

config/name="Tiny Learners"
config/description="Learn, Play & Grow - a colorful 2D educational game for young children."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(1, 0.972549, 0.909804, 1)
boot_splash/image="res://assets/images/logo.png"
config/icon="res://assets/images/logo.png"

[autoload]

GameData="*res://scripts/game_data.gd"
AudioManager="*res://scenes/common/AudioManager.tscn"
Navigation="*res://scripts/navigation.gd"

[audio]

buses/default_bus_layout="res://assets/theme/default_bus_layout.tres"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"
window/energy_saving/keep_screen_on=true
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
